# Bridge environment variables
# Copy this file outside the starter kit, edit paths, then source it before
# running scripts/manager-bridge.sh. Do not commit secrets or personal paths.

# Required: canonical project directory. Use an absolute path; paths with spaces
# are supported. Relative paths resolve from the shell that invokes
# manager-bridge.sh, but absolute paths avoid ambiguity.
export HERMES_PROJECT="$HOME/HermesBeadsDemo/project"

# Required: path to the OMP YAML config overlay for this bridge.
export HERMES_OMP_CONFIG="$HOME/.omp/agent/config-hermes-codex.yml"

# Required: state directory outside the project. Bridge creates runs/ and
# approvals/ inside it.
export HERMES_STATE_DIR="$HOME/.local/state/hermes-beads-opencode"

# Optional: explicit executables if `bd` or `omp` are not in PATH.
# export BD_BIN=/path/to/bd
# export OMP_BIN=/path/to/omp

# Provider credentials belong in your OMP auth setup or in env vars loaded
# separately, never in this file under version control. Configure OpenCode Go
# auth through OMP's interactive /login or provider picker, or through your
# own private environment outside this repository.
